# DevLens Environment Configuration Example
# Note: DevLens includes an offline heuristic engine that works 100% out-of-the-box with zero API keys required.
# If you wish to enable live cloud LLM integrations, configure the respective keys below or enter them via the in-app Settings modal.

# Google Gemini API (optional)
GEMINI_API_KEY=

# OpenAI API Key (optional)
OPENAI_API_KEY=

# Anthropic Claude API Key (optional)
CLAUDE_API_KEY=

# Application Port (default: 3000)
PORT=3000
